# Copy this file to .env and fill in your own values. Never commit .env.

# DMarket API keys (DMarket -> Settings -> API). Fake values below.
DMARKET_PUBLIC_KEY=replace-me
DMARKET_SECRET_KEY=replace-me-with-128-hex-characters

# Safety switch. 1 = only log what the bot would do. Set to 0 for real orders.
DRY_RUN=1

# Optional Telegram: notifications and the control panel (both or neither).
# Token from @BotFather, chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional tuning
GAME_ID=a8db
SCAN_INTERVAL_SEC=60
WATCHLIST_PATH=watchlist.json
LOG_FILE=logs/bot.log
HEARTBEAT_FILE=state/heartbeat.txt
